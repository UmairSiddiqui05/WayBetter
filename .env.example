# WayBetter environment template
# Copy to .env and fill in. NEVER commit .env (gitignored). NEVER hardcode any
# of these values in source — code reads them from environment only (CLAUDE.md).

# --- Runtime ---
ENVIRONMENT=development            # development | staging | production | test
API_BASE_URL=http://localhost:8000
SESSION_TOKEN_SECRET=change-me     # signs server-issued anonymous session tokens (N-05/N-06)
                                   # the API refuses to boot with this placeholder
                                   # when ENVIRONMENT=production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
CORS_ALLOW_ORIGINS=http://localhost:3000  # comma-separated; empty = no browser origins allowed
PROBE_TIMEOUT_SECONDS=2.0          # per-component timeout used by /readyz

# --- Datastores ---
# DATABASE_URL / REDIS_URL / OTP_BASE_URL below are the values used when the API
# runs on the host. docker-compose.yml overrides all three with its service names
# (db / redis / otp), so `make up` works with this file unedited.
DATABASE_URL=postgresql+psycopg://waybetter:waybetter@localhost:5432/waybetter
REDIS_URL=redis://localhost:6379/0

# --- Local Docker stack (docker-compose.yml) ---
POSTGRES_USER=waybetter            # local dev credentials only — never reuse in production
POSTGRES_PASSWORD=waybetter
POSTGRES_DB=waybetter
API_PORT=8000                      # host ports; change if something already binds them
POSTGRES_PORT=5432
REDIS_PORT=6379
OTP_PORT=8080
OTP_MAX_HEAP=8G                    # JVM heap for the OTP container (PLAN §2: 16 GB box)

# --- Routing engines ---
OTP_BASE_URL=http://localhost:8080  # self-hosted OpenTripPlanner
REGION_CONFIG_PATH=data/regions/nyc-metro.yaml

# --- External providers (all server-side only; never shipped to clients) ---
# Mapbox: driving traffic (Matrix/Directions/Isochrone) + geocoding.
# Use a SECRET token here; the web map uses a separate public token that is
# domain-restricted in the Mapbox dashboard (N-05).
MAPBOX_ACCESS_TOKEN=pk-or-sk-placeholder
MAPBOX_PUBLIC_TOKEN=pk-placeholder-domain-restricted

# MapTiler: web map tiles (MapLibre style URL key)
MAPTILER_API_KEY=placeholder

# Gemini: LLM for NL parsing + route explanations (behind LLMProvider; D-10)
GEMINI_API_KEY=placeholder

# Local LLM via Ollama for plain-words trip parsing (/trip/ai-parse; D-19). Runs on this
# machine, no key. Empty OLLAMA_MODEL = deterministic rules parser only. Any failure
# (not running, >20 s, invalid output) falls back to the rules parser automatically.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Transit agency feeds (register per agency; PLAN Phase 0) ---
NJT_DEVELOPER_USERNAME=placeholder   # NJ Transit developer portal (GTFS + GTFS-RT)
NJT_DEVELOPER_PASSWORD=placeholder
MTA_API_KEY=placeholder              # MTA GTFS-RT feeds (subway alerts etc.)

# --- Observability / spend guards (N-05, N-08) ---
# SENTRY_DSN is optional. Keep the comment on its own line: Docker Compose's
# env_file parser reads "KEY=   # comment" as the literal value "# comment".
SENTRY_DSN=
PROVIDER_SPEND_ALERT_EMAIL=umairsiddiqui2005@gmail.com
